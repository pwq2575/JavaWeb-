# 环境变量模板：复制为 .env（后端可放 ers-backend/.env，或直接设系统环境变量）
# 注意：.env 不要提交到 Git（见 .gitignore）

# ---- 数据库（MySQL 8）----
DB_URL=jdbc:mysql://localhost:3306/ers?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USER=ers_app
DB_PASSWORD=change-me

# ---- 鉴权 ----
# 至少 32 字符随机串；生成方式：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
JWT_TTL_HOURS=2

# ---- 服务 ----
APP_PORT=8080
# 前端开发服务器地址（用于 CORS 白名单）
APP_CORS_ORIGIN=http://localhost:5173

# ---- 可选：Redis 令牌黑名单（不启用则退出登录仅前端清令牌）----
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 演示账号初始化 ----
# 首次启动把种子数据中的 __DEMO__ 密码占位替换为该值（BCrypt 后再入库）
DEMO_PASSWORD=123456
